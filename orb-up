#!/usr/bin/env bash
set -euo pipefail

SESSION="${ORB_UP_SESSION:-amp-runner}"
UPDATE_CRON="${ORB_UP_UPDATE_CRON:-17 * * * *}"
CRON_MARKER="# orb-up automatic update"
STATE_DIR="${ORB_UP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/orb-up}"
SESSION_FILE_NAME="${SESSION//\//_}"
RUNNER_STATE_FILE="$STATE_DIR/$SESSION_FILE_NAME.state"
RESTART_PENDING_FILE="$STATE_DIR/$SESSION_FILE_NAME.restart-pending"
UPDATE_LOCK_DIR="$STATE_DIR/$SESSION_FILE_NAME.update-lock"
UPDATE_LOCK_HELD=0

usage() {
	cat <<'EOF'
Usage: orb-up <command>

Commands:
  start [directory] [amp options]  Start an Amp runner in tmux
  stop                             Stop the runner
  restart                          Restart the runner
  status                           Show whether the runner is running
  logs [lines]                     Show recent runner output (default: 200)
  attach                           Attach to the runner's tmux session
  update                           Update Amp and restart if it changed
  enable-updates                   Install the hourly update cron job
  disable-updates                  Remove the update cron job

Environment:
  ORB_UP_SESSION       tmux session name (default: amp-runner)
  ORB_UP_RUNNER_ID     stable Amp runner ID (default: short hostname)
  ORB_UP_UPDATE_CRON   five-field cron schedule (default: 17 * * * *)
  ORB_UP_STATE_DIR     runtime state directory
  AMP_BIN              path to the Amp executable
EOF
}

die() {
	printf 'orb-up: %s\n' "$*" >&2
	exit 1
}

need() {
	command -v "$1" >/dev/null 2>&1 || die "'$1' is required"
}

shell_quote() {
	local value="$1"
	value="${value//\'/\'\\\'\'}"
	printf "'%s'" "$value"
}

find_amp() {
	if [[ -n "${AMP_BIN:-}" && -x "$AMP_BIN" ]]; then
		printf '%s\n' "$AMP_BIN"
	elif command -v amp >/dev/null 2>&1; then
		command -v amp
	elif [[ -x "${AMP_HOME:-$HOME/.amp}/bin/amp" ]]; then
		printf '%s/bin/amp\n' "${AMP_HOME:-$HOME/.amp}"
	else
		die "Amp is not installed; run https://ampcode.com/install.sh"
	fi
}

has_session() {
	tmux has-session -t "$SESSION" 2>/dev/null
}

pane_is_dead() {
	[[ "$(tmux display-message -p -t "$SESSION" '#{pane_dead}')" == "1" ]]
}

amp_runner_command() {
	local pid="$1"
	local process_name command_line
	IFS= read -r process_name < <(ps -p "$pid" -o comm= 2>/dev/null) || return 1
	[[ "${process_name##*/}" == "amp" ]] || return 1
	IFS= read -r command_line < <(ps -p "$pid" -o command= 2>/dev/null) || return 1
	case "$command_line" in
		*" --no-tui" | *" --no-tui "*) printf '%s\n' "$command_line" ;;
		*) return 1 ;;
	esac
}

process_is_running() {
	local state
	IFS= read -r state < <(ps -p "$1" -o stat= 2>/dev/null) || return 1
	[[ -n "$state" && "$state" != Z* ]]
}

release_update_lock() {
	if [[ $UPDATE_LOCK_HELD -eq 1 ]]; then
		rm -rf "$UPDATE_LOCK_DIR"
		UPDATE_LOCK_HELD=0
	fi
}

acquire_update_lock() {
	if ! mkdir "$UPDATE_LOCK_DIR" 2>/dev/null; then
		# Give a concurrent lock owner time to record its PID before checking for a stale lock.
		sleep 0.1
		local owner_pid=""
		[[ ! -r "$UPDATE_LOCK_DIR/pid" ]] || read -r owner_pid < "$UPDATE_LOCK_DIR/pid" || true
		if [[ "$owner_pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$owner_pid" 2>/dev/null; then
			return 1
		fi
		rm -rf "$UPDATE_LOCK_DIR"
		mkdir "$UPDATE_LOCK_DIR" 2>/dev/null || return 1
	fi
	printf '%s\n' "$$" > "$UPDATE_LOCK_DIR/pid"
	UPDATE_LOCK_HELD=1
}

runner_activity() {
	if ! has_session; then
		printf 'stopped\n'
		return
	fi
	if pane_is_dead; then
		printf 'exited\n'
		return
	fi
	if [[ ! -r "$RUNNER_STATE_FILE" ]]; then
		printf 'unknown\n'
		return
	fi

	local state plugin_pid
	read -r state plugin_pid < "$RUNNER_STATE_FILE" || true
	if [[ ! "$plugin_pid" =~ ^[1-9][0-9]*$ ]] || ! kill -0 "$plugin_pid" 2>/dev/null; then
		printf 'unknown\n'
		return
	fi
	case "$state" in
		idle | busy) printf '%s\n' "$state" ;;
		*) printf 'unknown\n' ;;
	esac
}

restart_runner() {
	if ! has_session; then
		rm -f "$RESTART_PENDING_FILE"
		printf 'Runner is not started; the update will be used next time it starts.\n'
		return
	fi

	mkdir -p "$STATE_DIR"
	tmux set-environment -t "$SESSION" ORB_UP_RUNNER_STATE_FILE "$RUNNER_STATE_FILE"
	tmux respawn-pane -k -t "$SESSION"
	rm -f "$RESTART_PENDING_FILE"
	printf 'Restarted runner in tmux session %s.\n' "$SESSION"
}

start_runner() {
	need tmux
	need pgrep

	if has_session; then
		die "tmux session '$SESSION' already exists; use 'orb-up status' or 'orb-up restart'"
	fi

	local pid command_line reply attempts
	for pid in $(pgrep -U "$(id -u)" -x amp 2>/dev/null || true); do
		command_line="$(amp_runner_command "$pid" || true)"
		[[ -n "$command_line" ]] || continue

		local ancestor_pid="$PPID"
		while [[ "$ancestor_pid" =~ ^[1-9][0-9]*$ && "$ancestor_pid" -gt 1 ]]; do
			if [[ "$ancestor_pid" == "$pid" ]]; then
				die "cannot replace Amp runner PID $pid from a command running inside it; use a separate terminal"
			fi
			ancestor_pid="$(ps -p "$ancestor_pid" -o ppid= 2>/dev/null | tr -d ' ' || true)"
		done

		printf 'Found an unmanaged Amp runner (PID %s):\n  %s\n' "$pid" "$command_line" >&2
		printf 'Stop it before starting this runner? Only continue if it is idle. [y/N] ' >&2
		if ! IFS= read -r reply; then
			die "confirmation required; existing runner was not stopped"
		fi
		case "$reply" in
			y | Y | yes | YES | Yes) ;;
			*) die "existing runner was not stopped" ;;
		esac

		# Recheck the process before signaling in case the PID was reused while waiting for input.
		command_line="$(amp_runner_command "$pid" || true)"
		[[ -n "$command_line" ]] || continue
		kill "$pid"
		attempts=0
		while process_is_running "$pid" && [[ $attempts -lt 50 ]]; do
			sleep 0.1
			((attempts += 1))
		done
		process_is_running "$pid" && die "Amp runner PID $pid did not stop after 5 seconds"
		printf 'Stopped unmanaged Amp runner PID %s.\n' "$pid"
	done

	local directory="$PWD"
	if [[ $# -gt 0 && "$1" != -* ]]; then
		directory="$1"
		shift
	fi
	[[ -d "$directory" ]] || die "directory does not exist: $directory"
	directory="$(cd "$directory" && pwd)"

	local amp_bin
	amp_bin="$(find_amp)"

	local has_runner_id=0
	local arg
	for arg in "$@"; do
		case "$arg" in
			--runner-id | --runner-id=*) has_runner_id=1 ;;
		esac
	done
	if [[ $has_runner_id -eq 0 ]]; then
		set -- --runner-id "${ORB_UP_RUNNER_ID:-$(hostname -s)}" "$@"
	fi

	mkdir -p "$STATE_DIR"
	rm -f "$RUNNER_STATE_FILE" "$RESTART_PENDING_FILE"

	# Create the pane first so remain-on-exit is active even if Amp exits immediately.
	tmux new-session -d -s "$SESSION" -c "$directory"
	tmux set-option -t "$SESSION" remain-on-exit on >/dev/null
	tmux set-environment -t "$SESSION" PATH "$PATH"
	tmux set-environment -t "$SESSION" ORB_UP_RUNNER_STATE_FILE "$RUNNER_STATE_FILE"
	[[ -z "${AMP_API_KEY:-}" ]] || tmux set-environment -t "$SESSION" AMP_API_KEY "$AMP_API_KEY"
	[[ -z "${AMP_HOME:-}" ]] || tmux set-environment -t "$SESSION" AMP_HOME "$AMP_HOME"

	local runner_command=""
	for arg in "$amp_bin" --no-tui "$@"; do
		runner_command+="$(shell_quote "$arg") "
	done
	tmux respawn-pane -k -t "$SESSION" -c "$directory" "$runner_command"

	printf 'Started Amp runner in tmux session %s (directory: %s).\n' "$SESSION" "$directory"
	printf 'Use "orb-up logs" or "orb-up attach" to inspect it.\n'
}

stop_runner() {
	need tmux
	if has_session; then
		tmux kill-session -t "$SESSION"
		rm -f "$RUNNER_STATE_FILE" "$RESTART_PENDING_FILE"
		printf 'Stopped runner.\n'
	else
		printf 'Runner is not started.\n'
	fi
}

show_status() {
	need tmux
	if ! has_session; then
		printf 'stopped\n'
		return 1
	fi

	if pane_is_dead; then
		printf 'exited (tmux session: %s)\n' "$SESSION"
		return 1
	fi

	printf 'running, %s (tmux session: %s, directory: %s)\n' \
		"$(runner_activity)" "$SESSION" "$(tmux display-message -p -t "$SESSION" '#{pane_current_path}')"
}

show_logs() {
	need tmux
	has_session || die "runner is not started"
	local lines="${1:-200}"
	[[ "$lines" =~ ^[1-9][0-9]*$ ]] || die "line count must be a positive integer"
	tmux capture-pane -p -t "$SESSION" -S "-$lines"
}

update_amp() {
	need tmux
	mkdir -p "$STATE_DIR"
	if ! acquire_update_lock; then
		printf 'Another update check is already running; skipping.\n'
		return
	fi
	trap release_update_lock EXIT

	local activity amp_bin output
	activity="$(runner_activity)"
	if [[ "$activity" == "busy" || "$activity" == "unknown" ]]; then
		if [[ -f "$RESTART_PENDING_FILE" ]]; then
			printf 'Runner is %s; restart deferred until the next idle update check.\n' "$activity"
		else
			printf 'Runner is %s; update deferred until the next check.\n' "$activity"
		fi
		return
	fi
	amp_bin="$(find_amp)"
	if ! output="$("$amp_bin" update --porcelain 2>&1)"; then
		printf '%s\n' "$output" >&2
		return 1
	fi
	printf '%s\n' "$output"

	if printf '%s\n' "$output" | grep -q '^updated '; then
		touch "$RESTART_PENDING_FILE"
	fi

	if [[ -f "$RESTART_PENDING_FILE" ]]; then
		activity="$(runner_activity)"
		if [[ "$activity" == "busy" || "$activity" == "unknown" ]]; then
			printf 'Runner became %s; restart deferred until the next idle update check.\n' "$activity"
			return
		fi
		restart_runner
	fi
}

script_path() {
	local path="${BASH_SOURCE[0]}"
	if [[ "$path" != /* ]]; then
		path="$(cd "$(dirname "$path")" && pwd)/$(basename "$path")"
	fi
	printf '%s\n' "$path"
}

enable_updates() {
	need crontab
	mkdir -p "$STATE_DIR"

	local amp_bin executable log_file cron_line existing_crontab
	amp_bin="$(find_amp)"
	executable="$(script_path)"
	log_file="$STATE_DIR/update.log"
	cron_line="$UPDATE_CRON AMP_BIN=$(shell_quote "$amp_bin") ORB_UP_SESSION=$(shell_quote "$SESSION") ORB_UP_STATE_DIR=$(shell_quote "$STATE_DIR") $(shell_quote "$executable") update >> $(shell_quote "$log_file") 2>&1 $CRON_MARKER"
	existing_crontab="$(crontab -l 2>/dev/null || true)"

	{
		[[ -z "$existing_crontab" ]] || printf '%s\n' "$existing_crontab" | grep -vF "$CRON_MARKER" || true
		printf '%s\n' "$cron_line"
	} | crontab -

	printf 'Installed automatic update job: %s\n' "$UPDATE_CRON"
	printf 'Update log: %s\n' "$log_file"
}

disable_updates() {
	need crontab
	local existing_crontab
	existing_crontab="$(crontab -l 2>/dev/null || true)"
	{
		[[ -z "$existing_crontab" ]] || printf '%s\n' "$existing_crontab" | grep -vF "$CRON_MARKER" || true
	} | crontab -
	printf 'Removed automatic update job.\n'
}

command="${1:-}"
[[ $# -eq 0 ]] || shift

case "$command" in
	start) start_runner "$@" ;;
	stop) stop_runner ;;
	restart)
		need tmux
		has_session || die "runner is not started"
		restart_runner
		;;
	status) show_status ;;
	logs) show_logs "$@" ;;
	attach)
		need tmux
		has_session || die "runner is not started"
		exec tmux attach-session -t "$SESSION"
		;;
	update) update_amp ;;
	enable-updates) enable_updates ;;
	disable-updates) disable_updates ;;
	-h | --help | help) usage ;;
	'') usage; exit 1 ;;
	*) die "unknown command: $command (run 'orb-up --help')" ;;
esac
